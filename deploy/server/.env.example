# Example only: replace OWNER and VERSION with an actually published image.
LVK_IMAGE=ghcr.io/OWNER/lucky-vibe-kanban:VERSION
LVK_HOST=203.0.113.10
# Use automatic IP certificates with these Compose files. Keep port 80 open
# for Let's Encrypt validation and 443 open for HTTPS.
COMPOSE_FILE=compose.yaml:compose.acme.yaml
# Read https://letsencrypt.org/repository/ and change this to yes to agree.
LVK_ACME_AGREE_TOS=
# Optional contact address for your ACME account.
LVK_ACME_EMAIL=
# Optional. DNS *.preview.example.com must point to this server; the TLS
# certificate must cover both LVK_HOST and *.LVK_PREVIEW_DOMAIN. Requires
# externally managed certificates (COMPOSE_FILE=compose.yaml).
LVK_PREVIEW_DOMAIN=

# New deployments use LVK's locked setup. Preserve existing htpasswd protection
# until backend authentication is configured, then explicitly select backend.
LVK_PROXY_AUTH=auto
# Optional forced GUI mode: basic or auth0. Empty allows either in public mode.
LVK_AUTH_MODE=
# Optional exact HTTPS origin; empty derives https://LVK_HOST.
LVK_PUBLIC_URL=
# Optional source-development overrides (independent from the stable instance).
LVK_DEV_PROXY_AUTH=auto
LVK_DEV_AUTH_MODE=
LVK_DEV_PUBLIC_URL=
# Empty selects dev behind legacy Basic, preview (built assets) with backend auth.
# Explicit dev is rejected after removing the proxy guard.
LVK_DEV_FRONTEND_MODE=
